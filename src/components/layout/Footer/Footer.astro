---
import "./footer.css";
import creadoresLogo from "../../../assets/images/footer_creadores.png";

// Se cargan dinámicamente todos los logos de cada carpeta —
// no hace falta declarar nombres de archivo específicos.
const asociacionesFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../../../assets/images/footer/asociaciones/*.{png,svg,jpg,jpeg,webp}",
  { eager: true },
);
const certificacionesFiles = import.meta.glob<{ default: ImageMetadata }>(
  "../../../assets/images/footer/certificaciones/*.{png,svg,jpg,jpeg,webp}",
  { eager: true },
);

const asociaciones = Object.entries(asociacionesFiles)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({
    src: mod.default.src,
    name: path.split("/").pop() ?? "",
  }));

const certificaciones = Object.entries(certificacionesFiles)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({
    src: mod.default.src,
    name: path.split("/").pop() ?? "",
  }));
---

<footer id="site-footer" data-footer>
  <span class="footer-dot" aria-hidden="true"></span>

  <div class="footer-inner">
    <div class="footer-content">
      <img
        src={creadoresLogo.src}
        alt="Creadores de soluciones"
        class="footer-wordmark"
      />

      <div class="footer-contact">
        <p class="footer-address">
          Berlín 318, Del Carmen, Coyoacán, 04100, CDMX.
        </p>
        <a href="tel:5550005210" class="footer-link">55 5000 5210</a>
      </div>

      <div class="footer-social">
        <a
          href="#"
          class="footer-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Linkedin
        </a>
        <span aria-hidden="true">•</span>
        <a
          href="#"
          class="footer-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Facebook
        </a>
        <span aria-hidden="true">•</span>
        <a
          href="#"
          class="footer-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Instagram
        </a>
      </div>

      <div class="footer-badges">
        <div class="footer-badges-group">
          <span class="footer-badges-label">Asociaciones</span>
          <span class="footer-badges-divider" aria-hidden="true"></span>
          <div class="footer-badges-logos">
            {
              asociaciones.map((logo) => (
                <img src={logo.src} alt={logo.name} loading="lazy" />
              ))
            }
          </div>
        </div>

        <div class="footer-badges-group">
          <span class="footer-badges-label">Certificaciones</span>
          <span class="footer-badges-divider" aria-hidden="true"></span>
          <div class="footer-badges-logos">
            {
              certificaciones.map((logo) => (
                <img src={logo.src} alt={logo.name} loading="lazy" />
              ))
            }
          </div>
        </div>
      </div>

      <p class="footer-copy">
        <strong>©Grupo Pauta Creativa, S.A. de C.V.</strong> Todos los derechos reservados.
        <a href="#" class="footer-link">Aviso de privacidad</a>.
      </p>
    </div>

    <div class="footer-brand-badge" aria-hidden="true">
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
