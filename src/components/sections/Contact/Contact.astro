---
import "./contact.css";
import Section from "../../ui/Section/Section.astro";
import PlusIcon from "../../ui/PlusIcon/PlusIcon.astro";
import contactTitle from "../../../assets/images/tit_cuentanos_tu_reto.png";

import { contactForms } from "./contact.data";
import ContactForm from "./ContactForm.astro";
---

<Section id="contact" class="contact">
  <div class="contact-container">
    <!-- Encabezado -->
    <header class="contact-header">
      <div class="contact-label">
        <span class="contact-index">06/06</span>
        <span class="contact-name"> CONTACTO</span>
      </div>
    </header>

    <!-- Contenido -->
    <div class="contact-layout">
      <!-- Vista inicial -->
      <div class="contact-intro">
        <img
          src={contactTitle.src}
          alt="Cuéntanos tu reto"
          class="contact-title"
          data-contact-title
        />
        <div class="contact-description-row">
          <p class="contact-description">
            Nuestro equipo estratégico te contactará para definir los siguientes
            pasos.
          </p>

          <div class="contact-decoration">
            <PlusIcon class="contact-plus contact-plus--white" />
            <PlusIcon class="contact-plus contact-plus--black" />
          </div>
        </div>

        <nav class="contact-selector" aria-label="Tipo de contacto">
          <button type="button" class="contact-option" data-form="clientes">
            Clientes
          </button>

          <button type="button" class="contact-option" data-form="trabajo">
            Bolsa de trabajo
          </button>

          <button type="button" class="contact-option" data-form="proveedores">
            Proveedores
          </button>
        </nav>
      </div>

      <!-- Aquí aparecerá el formulario -->
      <div
        class="contact-form-wrapper"
        data-contact-form
        data-default-title={contactTitle.src}
        data-title-clientes={contactForms.clientes.titleImage}
        data-title-trabajo={contactForms.trabajo.titleImage}
        data-title-proveedores={contactForms.proveedores.titleImage}
      >
        <div data-form-panel="clientes">
          <ContactForm formType="clientes" />
        </div>

        <div data-form-panel="trabajo">
          <ContactForm formType="trabajo" />
        </div>

        <div data-form-panel="proveedores">
          <ContactForm formType="proveedores" />
        </div>
      </div>
    </div>
  </div>
</Section>

<script>
  import "./contact";
</script>
