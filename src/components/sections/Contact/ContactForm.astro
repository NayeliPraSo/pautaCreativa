---
import "./contactForm.css";

import { actions } from "astro:actions";
import { contactForms, type ContactFormType } from "./contact.data";

interface Props {
  formType: ContactFormType;
}

const { formType } = Astro.props;

const form = contactForms[formType];
---

<form
  class="contact-form"
  data-form-type={formType}
  method="POST"
  enctype="multipart/form-data"
  action={actions.contact}
>
  <!-- Tipo de formulario para el backend -->
  <input type="hidden" name="formType" value={formType} />

  <!-- Honeypot antispam -->
  <input
    class="contact-honeypot"
    name="website"
    type="text"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="contact-form-fields">
    {
      form.fields.map((field) => (
        <div class={`contact-field contact-field--${field.type}`}>
          <label for={`${formType}-${field.name}`} class="contact-field-label">
            {field.label}
          </label>

          {field.type === "textarea" ? (
            <textarea
              id={`${formType}-${field.name}`}
              name={field.name}
              class="contact-field-input contact-field-textarea"
              required={field.required}
              placeholder={field.placeholder}
            />
          ) : field.type === "file" ? (
            <div class="contact-file">
              <input
                id={`${formType}-${field.name}`}
                name="attachment"
                type="file"
                class="contact-file-input"
                required={field.required}
                accept={field.accept}
              />

              <label
                for={`${formType}-${field.name}`}
                class="contact-file-label"
              >
                <span class="contact-file-button">Adjuntar archivo</span>

                <span class="contact-file-name">
                  Ningún archivo seleccionado
                </span>
              </label>
            </div>
          ) : (
            <input
              id={`${formType}-${field.name}`}
              name={field.name}
              type={field.type}
              class="contact-field-input"
              required={field.required}
              placeholder={field.placeholder}
            />
          )}
        </div>
      ))
    }
  </div>

  <!-- Footer del formulario -->
  <div class="contact-form-footer">
    <label class="contact-privacy">
      <input
        type="checkbox"
        name="privacy"
        class="contact-privacy-input"
        required
      />

      <span class="contact-privacy-check" aria-hidden="true"></span>

      <span class="contact-privacy-text">
        He leído y acepto el{" "}
        <a
          href={`${import.meta.env.BASE_URL}aviso-de-privacidad`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Aviso de Privacidad
        </a>
      </span>
    </label>

    <button type="submit" class="contact-submit">
      {form.submitLabel}
    </button>
  </div>
</form>
