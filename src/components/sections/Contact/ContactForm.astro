---
import "./contactForm.css";

import { contactForms, type ContactFormType } from "./contact.data";

interface Props {
  formType: ContactFormType;
}

const { formType } = Astro.props;

const form = contactForms[formType];
---

<form class="contact-form" data-form-type={formType}>
  <!--
    Identifica qué formulario se está enviando.
    El backend PHP valida este valor.
  -->
  <input type="hidden" name="formType" value={formType} />

  <!--
    Honeypot antispam.
    Debe permanecer vacío.
  -->
  <input
    class="contact-honeypot"
    name="website"
    type="text"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <div class="contact-form-fields">
    {
      form.fields.map((field) => (
        <div class={`contact-field contact-field--${field.type}`}>
          <label for={`${formType}-${field.name}`} class="contact-field-label">
            {field.label}
          </label>

          {field.type === "textarea" ? (
            <textarea
              id={`${formType}-${field.name}`}
              name={field.name}
              class="contact-field-input contact-field-textarea"
              required={field.required}
              placeholder={field.placeholder}
            />
          ) : field.type === "file" ? (
            <div class="contact-file">
              <input
                id={`${formType}-${field.name}`}
                name="attachment"
                type="file"
                class="contact-file-input"
                required={field.required}
                accept=".pdf,application/pdf"
                data-max-size="5242880"
              />

              <label
                for={`${formType}-${field.name}`}
                class="contact-file-button"
              >
                Seleccionar archivo
              </label>

              <span class="contact-file-name">Ningún archivo seleccionado</span>
            </div>
          ) : (
            <input
              id={`${formType}-${field.name}`}
              name={field.name}
              type={field.type}
              class="contact-field-input"
              required={field.required}
              placeholder={field.placeholder}
            />
          )}
        </div>
      ))
    }
  </div>

  <div class="contact-form-footer">
    <label class="contact-privacy">
      <input type="checkbox" name="privacy" required />

      <span class="contact-privacy-text">
        He leído y acepto el{" "}
        <a
          href={`${import.meta.env.BASE_URL}aviso-de-privacidad/`}
          target="_blank"
          rel="noopener noreferrer"
        >
          Aviso de Privacidad
        </a>
        .
      </span>
    </label>

    <button type="submit" class="contact-submit">
      {form.submitLabel}
    </button>

    <p
      class="contact-form-status"
      data-form-status
      role="status"
      aria-live="polite"
    >
    </p>
  </div>
</form>
