---
import "./solutions.css";
import Section from "../../ui/Section/Section.astro";
import ScrollIndicator from "../../ui/ScrollIndicator/ScrollIndicator.astro";
import PlusIcon from "../../ui/PlusIcon/PlusIcon.astro";

import SolutionsDiagram from "./SolutionsDiagram.astro";
---

<Section id="soluciones" class="solutions">
  <!-- Fondo dinámico -->
  <div
    class="solutions-background"
    aria-hidden="true"
    data-solutions-background
  >
  </div>

  <!-- Overlay -->
  <div class="solutions-overlay" aria-hidden="true"></div>

  <div class="solutions-container">
    <!-- Header -->

    <header class="solutions-header">
      <div class="solutions-index">
        <span class="solutions-index-number">03 / 06</span>
        <span class="solutions-index-label">Soluciones</span>
      </div>

      <div class="solutions-intro">
        <PlusIcon class="solutions-plus" />

        <p>
          Creemos que las grandes ideas no deberían quedarse en la mente ni en
          el papel. Deben ponerse en movimiento y convertirse en <strong>
            soluciones</strong
          > que generen impacto duradero en la mente de los consumidores.
        </p>
      </div>
    </header>

    <!-- Contenido -->

    <div class="solutions-content">
      <!-- Diagrama SVG -->

      <SolutionsDiagram />
    </div>
  </div>

  <ScrollIndicator class="solutions-scroll" />
</Section>

<script>
  import "./solutions";
</script>
