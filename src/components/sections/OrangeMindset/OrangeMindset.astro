---
import "./orange-mindset.css";
import Section from "../../ui/Section/Section.astro";
import PlusIcon from "../../ui/PlusIcon/PlusIcon.astro";

import naranja from "../../../assets/images/orange-mindset/naranja.png";
import vivimosEl from "../../../assets/images/orange-mindset/vivimos-el.png";
import orangeTitle from "../../../assets/images/orange-mindset/orange.png";
import mindsetTitle from "../../../assets/images/orange-mindset/mindset.png";
const mindsetValues: string[] = [
  "Colaborativa",
  "Valiente",
  "Humana",
  "Confiable",
  "Apasionada",
  "Optimista",
];
---

<Section id="orange-mindset" class="orange-mindset">
  <div class="om-bg-peel" aria-hidden="true"></div>
  <div class="om-anchor" aria-hidden="true">
    <div class="om-index">
      <span class="om-index-number">02 / 06</span>
      <span class="om-index-label">Orange Mindset</span>
    </div>

    <div class="om-content">
      <div class="om-visual">
        <img src={vivimosEl.src} alt="" class="om-visual-vivimos" />

        <div class="om-orange-lockup">
          <img src={orangeTitle.src} alt="" class="om-visual-orange-title" />
          <img src={naranja.src} alt="" class="om-visual-fruit" />
          <img src={mindsetTitle.src} alt="" class="om-visual-mindset-title" />
        </div>
      </div>
    </div>

    <div class="om-divider"></div>
  </div>

  <div class="om-slider">
    <!-- Panel 1 -->
    <div class="om-panel om-panel-1">
      <div class="om-index">
        <span class="om-index-number">02 / 06</span>
        <span class="om-index-label">Orange Mindset</span>
      </div>

      <div class="om-content">
        <!--
          Copia SOLO para mobile. En desktop se oculta con
          visibility:hidden (conserva el espacio para que
          .om-copy quede alineada donde siempre) y la versión
          visible es la del .om-anchor de arriba.
        -->
        <div class="om-visual" aria-hidden="true">
          <img src={vivimosEl.src} alt="" class="om-visual-vivimos" />

          <div class="om-orange-lockup">
            <img src={orangeTitle.src} alt="" class="om-visual-orange-title" />
            <img src={naranja.src} alt="" class="om-visual-fruit" />
            <img
              src={mindsetTitle.src}
              alt=""
              class="om-visual-mindset-title"
            />
          </div>
        </div>

        <p class="om-copy">
          Es la actitud y la energía con la que asumimos cada proyecto: siempre
          buscando el <strong>cómo sí.</strong>
        </p>
      </div>

      <!-- Divider solo para mobile (ver nota arriba) -->
      <div class="om-divider" aria-hidden="true"></div>
    </div>

    <!-- Panel 2 -->
    <div class="om-panel om-panel-2">
      <div class="om-panel-2-content">
        <p class="om-intro">
          Por eso reunimos equipos multidisciplinarios con una forma particular
          de pensar:
        </p>

        <div class="om-timeline-hint" aria-hidden="true">
          <span class="om-timeline-hint__arrow"> ← </span>
          <span class="om-timeline-hint__arrow"> → </span>
        </div>

        <div
          class="om-timeline"
          style={`--timeline-count: ${mindsetValues.length}`}
        >
          {
            mindsetValues.map((value) => (
              <div class="om-timeline-item">
                <span class="om-timeline-label">{value}</span>
                <span class="om-timeline-dot" />
              </div>
            ))
          }
        </div>

        <div class="om-description-wrap">
          <p class="om-description">
            <PlusIcon class="om-description-icon" size={20} strokeWidth={3} />
            Sumamos talento para crear experiencias <strong
              >que conectan a las personas con las marcas</strong
            > de manera orgánica, relevante y poderosa.
          </p>
        </div>
      </div>
    </div>
  </div>
</Section>

<script>
  import "./orange-mindset";
</script>
